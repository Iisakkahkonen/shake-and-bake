{
  "name": "shake-and-bake-parser",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "vars": {
    "APP_ORIGIN": "https://iisakkahkonen.github.io"
  },
  "ratelimits": [
    {
      "name": "PARSE_LIMIT",
      "namespace_id": "42761953",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "GEMINI_API_KEY",
      "RECIPE_IMPORT_CODE"
    ]
  }
}
